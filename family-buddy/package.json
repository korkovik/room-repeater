{
  "name": "family-buddy",
  "version": "0.1.0",
  "private": true,
  "description": "Family Buddy: a static, local-only parenting companion (CS/EN). No build step; dev/ is served as-is.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p jsconfig.json",
    "lint": "eslint .",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "validate": "node scripts/validate-content.mjs",
    "validate:release": "node scripts/validate-content.mjs --release",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run validate",
    "test:e2e": "playwright test",
    "serve": "node tests/e2e/server.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
