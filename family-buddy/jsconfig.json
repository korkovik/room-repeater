{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": { "punycode": ["./node_modules/@types/node/punycode.d.ts"] },
    "forceConsistentCasingInFileNames": true
  },
  "include": ["dev/js/**/*.js", "scripts/**/*.mjs", "tests/**/*.mjs", "tests/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "uat"]
}
